DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pongo_inventory_os
APP_ENV=development
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
AUTH_REQUIRED=true
AUTH_COOKIE_NAME=pongo_session
AUTH_SESSION_HOURS=336
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCKOUT_MINUTES=15
REGISTRATION_ENABLED=true
# Required for every registration in production, including the first account; use at least 32 random bytes.
REGISTRATION_ACCESS_CODE=
OPERATIONS_ALERT_WEBHOOK_URL=
OPERATIONS_ALERT_FAILURE_THRESHOLD=3

WOOCOMMERCE_BASE_URL=
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=
WOOCOMMERCE_CONFIGURATION_ENCRYPTION_KEY=
WOOCOMMERCE_ENVIRONMENT=development
WOOCOMMERCE_READ_ENABLED=true
WOOCOMMERCE_READ_ONLY=true
WOOCOMMERCE_WRITEBACK_ENABLED=false
WOOCOMMERCE_WRITEBACK_DRY_RUN=true
WOOCOMMERCE_STAGING_LIVE_TEST_MODE=false
WOOCOMMERCE_ALLOW_STOCK_WRITE=false
# Set to pongo only after the staging stock contract passes and Pongo is the chosen production stock authority.
WOOCOMMERCE_PRODUCTION_STOCK_AUTHORITY=disabled
WOOCOMMERCE_ALLOW_ORDER_STATUS_WRITE=false
WOOCOMMERCE_ALLOW_PRODUCT_METADATA_WRITE=false
WOOCOMMERCE_ALLOW_CUSTOMER_WRITE=false
WOOCOMMERCE_ALLOW_COUPON_WRITE=false
WOOCOMMERCE_ALLOW_REFUND_WRITE=false
WOOCOMMERCE_ALLOW_DELETE=false
WOOCOMMERCE_ALLOWED_HOST=
WOOCOMMERCE_TIMEOUT_SECONDS=30
WOOCOMMERCE_PAGE_SIZE=100
WOOCOMMERCE_ORDER_SYNC_PAGE_SIZE=100
WOOCOMMERCE_ORDER_SYNC_DEFAULT_STATUSES=processing,on-hold,pending
WOOCOMMERCE_ORDER_RECONCILIATION_ENABLED=true
WOOCOMMERCE_ORDER_RECONCILIATION_INTERVAL_SECONDS=60
WOOCOMMERCE_ORDER_RECONCILIATION_STALE_AFTER_SECONDS=300
WOOCOMMERCE_ORDER_RECONCILIATION_LOOKBACK_HOURS=168
WOOCOMMERCE_ORDER_RECONCILIATION_STATUSES=processing,on-hold,pending,completed,failed,cancelled,refunded
WOOCOMMERCE_STOCK_SYNC_JOBS_ENABLED=true
WOOCOMMERCE_STOCK_SYNC_JOB_INTERVAL_SECONDS=3
WOOCOMMERCE_STOCK_SYNC_JOB_STALE_SECONDS=900
WOOCOMMERCE_STOCK_SYNC_MAX_RETRIES=3
WOOCOMMERCE_WEBHOOK_ENABLED=false
WOOCOMMERCE_WEBHOOK_SECRET=
WOOCOMMERCE_WEBHOOK_MAX_BODY_BYTES=1048576

MAP_PROVIDER=
MAP_API_KEY=
ROUTE_GEO_PROVIDER=disabled
ROUTE_MAP_PROVIDER=disabled
ROUTE_OPTIMIZATION_PROVIDER=disabled
GOOGLE_REPORTS_CLIENT_ID=
GOOGLE_REPORTS_CLIENT_SECRET=
GOOGLE_REPORTS_REFRESH_TOKEN=
GOOGLE_REPORTS_FOLDER_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
